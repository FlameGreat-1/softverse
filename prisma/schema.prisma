generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  role      String   @default("ADMIN") // Keeping it simple: anyone in DB is admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  content     String   @db.Text      // Will store TipTap HTML or JSON
  excerpt     String?  @db.Text
  coverImage  String?
  published   Boolean  @default(false)
  views       Int      @default(0)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        String[] // Array support in PostgreSQL
  scheduledPosts ScheduledPost[]

  @@index([slug])
}

// Stores platform credentials like Twitter API Keys, LinkedIn Tokens, QStash tokens
model SystemSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Tracks the status of background scheduled posts
model ScheduledPost {
  id             String   @id @default(cuid())
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  platforms      String[] // e.g., ["TWITTER", "LINKEDIN"]
  socialCaption  String?  @db.Text
  scheduledFor   DateTime
  status         String   @default("PENDING") // PENDING, SUCCESS, FAILED
  errorMessage   String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, scheduledFor])
}

// Stores project requests submitted by clients from the frontend
model ProjectRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  location     String?
  projectType  String
  businessName String?
  timeline     String?
  budget       String?
  details      String   @db.Text
  attachments  String[] @default([])
  source       String   @default("Email Submission")
  createdAt    DateTime @default(now())
}
